# Puerto del servidor
PORT=3001

# MongoDB Connection String
MONGO_CONNECT=mongodb://localhost:27017/usuarios_db
# O para MongoDB Atlas:
# MONGO_CONNECT=mongodb+srv://usuario:contraseña@cluster.mongodb.net/usuarios_db

# JWT Secret
JWT_SECRET=tu_clave_secreta_super_segura_aqui

# Entorno
NODE_ENV=development

# URL del frontend autorizada por CORS, SIN barra final.
# Si no coincide con el dominio real del front, el navegador bloquea las
# peticiones. Los puertos locales (5173, 5174, 5175, 4173) ya están permitidos.
FRONT_URL=https://creaconstrucciones.vercel.app

# Cloudflare R2 es el ÚNICO destino de fotos y videos.
# Si falta alguna de estas variables el upload responde 503 (no hay respaldo).
R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=tu_access_key_id
R2_SECRET_ACCESS_KEY=tu_secret_access_key
R2_BUCKET=pintura-vial
# URL pública del bucket (subdominio r2.dev o dominio propio), SIN barra final
R2_PUBLIC_URL=https://pub-xxxxxxxx.r2.dev
